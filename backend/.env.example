# Copy this file to `.env` and fill in real values. `.env` is git-ignored — never commit it.

ENV=development

# --- Database ---
# Local Docker Postgres (infra/docker-compose.yml overrides this with @db:5432):
#   DATABASE_URL=postgresql+psycopg2://vip_user:vip_pass@db:5432/vip_db
# Neon (free hosted Postgres + pgvector) — take the "psycopg2" / connection string
# from the Neon dashboard and prefix the driver. Keep ?sslmode=require.
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require

# Where uploaded audio + knowledge documents are written (optional; sensible default).
# STORAGE_DIR=./storage

# --- Auth (Phase 1) ---
# Generate a strong value:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-env-file

# CORS — JSON array of allowed origins
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Speech-to-text (Phase 2, Faster-Whisper) ---
# tiny | base | small | medium | large-v3   (smaller = faster, less accurate)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Retrieval (Phase 3/4) ---
# If you change the embedding model you MUST update EMBEDDING_DIM in
# app/models/knowledge.py to match (e5-small=384, e5-base=768, e5-large=1024)
# and regenerate the migration.
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large
RAG_TOP_K=5
# Best-match cosine similarity (0..1) required before the LLM may answer. Below
# this the system returns a human-handoff message instead of guessing.
# multilingual-e5 runs hot: unrelated text ~0.74, a real match ~0.80+.
RAG_CONFIDENCE_THRESHOLD=0.78
# A question cluster is flagged as a knowledge gap when its best KB match is
# below this (Phase 8). Clusters in a band around it are checked by running the
# question through the answer pipeline — a refusal counts as a gap.
GAP_SIMILARITY_THRESHOLD=0.80
# Cosine similarity for two customer questions to join the same cluster.
CLUSTER_SIMILARITY_THRESHOLD=0.89

# --- LLM answer generation (Phase 4) ---
# LLM_PROVIDER: google | anthropic | mock   (mock = offline canned reply, for tests)
LLM_PROVIDER=google
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0.2

# Google Gemini (default). Key: https://aistudio.google.com/apikey
# This is the API's own free tier — a Google AI Pro/Ultra subscription does NOT
# change it. gemini-2.5-flash-lite has its own (larger) free quota, separate from
# gemini-2.5-flash; use flash-lite unless you've linked a billing account.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Anthropic Claude (optional path — the original spec's LLM). Needs
# `uv pip install --python .venv anthropic`. Key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Text-to-speech (Phase 6) ---
# TTS_PROVIDER: google (uses GOOGLE_API_KEY above) | mock (silent wav, for tests)
TTS_PROVIDER=google
TTS_AUTOSPEAK_VOICE_REPLIES=true
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
TTS_VOICE=Kore
