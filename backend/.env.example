# Copy this file to `.env` and fill in real values. `.env` is git-ignored — never commit it.

ENV=development

# --- Database ---
# Inside docker-compose this is overridden by the compose file's `environment:` block.
# Set it here for running the app / alembic outside Docker.
DATABASE_URL=postgresql+psycopg2://vip_user:vip_pass@db:5432/vip_db

# --- Auth (Phase 1) ---
# Generate a strong value:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-env-file

# CORS — JSON array of allowed origins
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Speech-to-text (Phase 2, Faster-Whisper) ---
# tiny | base | small | medium | large-v3   (smaller = faster, less accurate)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Embeddings (Phase 3) ---
# If you change this, you MUST update EMBEDDING_DIM in app/models/knowledge.py to match
# (e5-small=384, e5-base=768, e5-large=1024) and regenerate the migration.
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large

# --- LLM (Phase 4, Claude API) ---
# Get a key from https://console.anthropic.com/ — keep it only in your local .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Minimum retrieval similarity (0..1) required before the LLM is allowed to answer.
# Below this, the system refuses and offers a human handoff instead of guessing.
RAG_CONFIDENCE_THRESHOLD=0.72
